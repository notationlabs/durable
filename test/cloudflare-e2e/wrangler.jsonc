{
  "name": "durable-e2e-test",
  "main": "worker.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      { "name": "WORKFLOWS", "class_name": "Workflows" },
      { "name": "PROBE", "class_name": "Probe" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Workflows", "Probe"] }],
  "observability": { "enabled": true }
}
